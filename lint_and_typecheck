#!/bin/bash
set -e  # Exit immediately if any command fails

# Define color codes
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# Function to print and run a step
run_step() {
    local step_name="$1"
    local command="$2"

    echo -e "${YELLOW}==========================${RESET}"
    echo -e "${YELLOW}Step: $step_name${RESET}"
    echo -e "${YELLOW}==========================${RESET}"
    echo -e "${CYAN}Running: $command${RESET}"
    eval "$command"
    echo -e "${GREEN}Success: $step_name completed!${RESET}\n"
}

# Run steps
run_step "Type checking with mypy" "mypy $1"
run_step "Linting with pylint" "pylint --rcfile $CBGEN_PATH/settings/.pylintrc --fail-under=10.00 $1"
run_step "Code style check with flake8" "flake8 --config $CBGEN_PATH/settings/.flake8 $1"

# Final message
echo -e "${GREEN}=================================${RESET}"
echo -e "${GREEN}Linting and type-checking passed!${RESET}"
echo -e "${GREEN}=================================${RESET}"